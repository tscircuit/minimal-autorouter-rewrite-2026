{
  "name": "@tscircuit/minimal-autorouter-rewrite-2026",
  "version": "0.1.0",
  "type": "module",
  "description": "An independent solver-pattern implementation of the Pipeline9 autorouter interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/minimal-autorouter-rewrite-2026.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "lib"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/*": "./lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup lib/index.ts --format esm --dts --sourcemap",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 300000",
    "start": "cosmos",
    "fixtures:build": "cosmos-export",
    "benchmark": "bun scripts/benchmark/run.ts",
    "validate:pcb": "bun scripts/validation/run.ts"
  },
  "devDependencies": {
    "@tscircuit/checks": "0.0.184",
    "@tscircuit/circuit-json-util": "0.0.111",
    "@types/bun": "^1.2.23",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "circuit-json": "0.0.485",
    "react": "^18.3.1",
    "react-cosmos": "^6.2.3",
    "react-cosmos-plugin-vite": "^6.2.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.11"
  }
}
