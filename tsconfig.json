{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {"lib/*": ["lib/*"]}
  },
  "include": ["lib", "tests", "fixtures", "scripts", "vite.config.ts"]
}
